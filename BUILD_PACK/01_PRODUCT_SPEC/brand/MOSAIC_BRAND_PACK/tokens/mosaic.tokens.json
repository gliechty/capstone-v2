{
  "$description": "MOSAIC design tokens v1 (2026-10-21). Colour values from Hera kit v2; 'derived' values added for UI states and WCAG contrast.",
  "color": {
    "paper": {
      "$type": "color",
      "$value": "#FAF8F3",
      "$description": "Page background. Warm off-white.",
      "$extensions": {
        "mosaic.origin": "kit"
      }
    },
    "paper-raised": {
      "$type": "color",
      "$value": "#FFFDF9",
      "$description": "Cards and question surfaces on paper.",
      "$extensions": {
        "mosaic.origin": "app"
      }
    },
    "paper-muted": {
      "$type": "color",
      "$value": "#F1EDE4",
      "$description": "Quiet panels, bar tracks on raised cards, code blocks.",
      "$extensions": {
        "mosaic.origin": "derived"
      }
    },
    "ink": {
      "$type": "color",
      "$value": "#1B2A41",
      "$description": "Body text, headings, wordmark, line work. 13.6:1 on paper.",
      "$extensions": {
        "mosaic.origin": "kit"
      }
    },
    "slate": {
      "$type": "color",
      "$value": "#5B6B7F",
      "$description": "Secondary text, captions, metadata. 5.1:1 on paper.",
      "$extensions": {
        "mosaic.origin": "kit"
      }
    },
    "rule": {
      "$type": "color",
      "$value": "#E4E0D6",
      "$description": "Hairlines, dividers, empty tiles, bar tracks. Decorative only (1.2:1).",
      "$extensions": {
        "mosaic.origin": "kit"
      }
    },
    "rule-strong": {
      "$type": "color",
      "$value": "#7D7A70",
      "$description": "Form-control borders and focus-independent outlines. 4.0:1 on paper (meets 3:1 non-text).",
      "$extensions": {
        "mosaic.origin": "derived"
      }
    },
    "teal": {
      "$type": "color",
      "$value": "#2E7D7A",
      "$description": "MOSAIC's own work: score and weight bars, connecting threads, selected states, primary buttons. 4.6:1 on paper.",
      "$extensions": {
        "mosaic.origin": "kit"
      }
    },
    "teal-deep": {
      "$type": "color",
      "$value": "#24605E",
      "$description": "Teal for text, links, hover and text on teal-soft. 6.8:1 on paper.",
      "$extensions": {
        "mosaic.origin": "derived"
      }
    },
    "teal-soft": {
      "$type": "color",
      "$value": "#E3EFEE",
      "$description": "Selected-option background, text selection. Pair with teal-deep text.",
      "$extensions": {
        "mosaic.origin": "derived"
      }
    },
    "ochre": {
      "$type": "color",
      "$value": "#C99A3B",
      "$description": "The single highest-priority item ('Start here'). At most one per screen. Fill/marker only, never text (2.4:1).",
      "$extensions": {
        "mosaic.origin": "kit"
      }
    },
    "ochre-deep": {
      "$type": "color",
      "$value": "#8A6418",
      "$description": "Text label on ochre-soft for the 'Start here' tag. 4.5:1 on ochre-soft.",
      "$extensions": {
        "mosaic.origin": "derived"
      }
    },
    "ochre-soft": {
      "$type": "color",
      "$value": "#F4EBD6",
      "$description": "Background of the one 'Start here' card or tag.",
      "$extensions": {
        "mosaic.origin": "derived"
      }
    },
    "plum": {
      "$type": "color",
      "$value": "#86607F",
      "$description": "Source tile 1 (provenance only).",
      "$extensions": {
        "mosaic.origin": "kit"
      }
    },
    "slate-blue": {
      "$type": "color",
      "$value": "#4C6A9A",
      "$description": "Source tile 2 (provenance only).",
      "$extensions": {
        "mosaic.origin": "kit"
      }
    },
    "sage": {
      "$type": "color",
      "$value": "#7E9C6E",
      "$description": "Source tile 3 (provenance only). Fill only, never text (2.9:1).",
      "$extensions": {
        "mosaic.origin": "kit"
      }
    },
    "terracotta": {
      "$type": "color",
      "$value": "#B4664A",
      "$description": "Source tile 4 (provenance only). Fill only, never body text (4.0:1).",
      "$extensions": {
        "mosaic.origin": "kit"
      }
    },
    "on-teal": {
      "$type": "color",
      "$value": "#FFFDF9",
      "$description": "Text on teal fills. 4.9:1.",
      "$extensions": {
        "mosaic.origin": "derived"
      }
    },
    "error": {
      "$type": "color",
      "$value": "#8E2F25",
      "$description": "Error text and icon. Always with an icon and words.",
      "$extensions": {
        "mosaic.origin": "derived"
      }
    },
    "error-soft": {
      "$type": "color",
      "$value": "#F7E4DF",
      "$description": "Error banner background.",
      "$extensions": {
        "mosaic.origin": "derived"
      }
    },
    "warning": {
      "$type": "color",
      "$value": "#5E4A1C",
      "$description": "Warning text and icon. Kept brown and neutral so it never reads as the ochre priority.",
      "$extensions": {
        "mosaic.origin": "derived"
      }
    },
    "warning-soft": {
      "$type": "color",
      "$value": "#F2ECDD",
      "$description": "Warning banner background.",
      "$extensions": {
        "mosaic.origin": "derived"
      }
    },
    "success": {
      "$type": "color",
      "$value": "#2D5A3D",
      "$description": "Success text and icon. Muted; never a large green field.",
      "$extensions": {
        "mosaic.origin": "derived"
      }
    },
    "success-soft": {
      "$type": "color",
      "$value": "#E4EFE6",
      "$description": "Success banner background.",
      "$extensions": {
        "mosaic.origin": "derived"
      }
    }
  },
  "semantic": {
    "surface": {
      "$type": "color",
      "$value": "{color.paper}"
    },
    "surface-raised": {
      "$type": "color",
      "$value": "{color.paper-raised}"
    },
    "surface-muted": {
      "$type": "color",
      "$value": "{color.paper-muted}"
    },
    "text": {
      "$type": "color",
      "$value": "{color.ink}"
    },
    "text-muted": {
      "$type": "color",
      "$value": "{color.slate}"
    },
    "accent": {
      "$type": "color",
      "$value": "{color.teal}"
    },
    "accent-hover": {
      "$type": "color",
      "$value": "{color.teal-deep}"
    },
    "accent-soft": {
      "$type": "color",
      "$value": "{color.teal-soft}"
    },
    "accent-text": {
      "$type": "color",
      "$value": "{color.teal-deep}"
    },
    "on-accent": {
      "$type": "color",
      "$value": "{color.on-teal}"
    },
    "border": {
      "$type": "color",
      "$value": "{color.rule}"
    },
    "border-strong": {
      "$type": "color",
      "$value": "{color.rule-strong}"
    },
    "priority": {
      "$type": "color",
      "$value": "{color.ochre}"
    },
    "priority-soft": {
      "$type": "color",
      "$value": "{color.ochre-soft}"
    },
    "priority-text": {
      "$type": "color",
      "$value": "{color.ochre-deep}"
    },
    "source-1": {
      "$type": "color",
      "$value": "{color.plum}"
    },
    "source-2": {
      "$type": "color",
      "$value": "{color.slate-blue}"
    },
    "source-3": {
      "$type": "color",
      "$value": "{color.sage}"
    },
    "source-4": {
      "$type": "color",
      "$value": "{color.terracotta}"
    },
    "status-error": {
      "$type": "color",
      "$value": "{color.error}"
    },
    "status-error-soft": {
      "$type": "color",
      "$value": "{color.error-soft}"
    },
    "status-warning": {
      "$type": "color",
      "$value": "{color.warning}"
    },
    "status-warning-soft": {
      "$type": "color",
      "$value": "{color.warning-soft}"
    },
    "status-success": {
      "$type": "color",
      "$value": "{color.success}"
    },
    "status-success-soft": {
      "$type": "color",
      "$value": "{color.success-soft}"
    }
  },
  "category": {
    "people": {
      "$type": "color",
      "$value": "{color.teal}",
      "$description": "Category accent. Default is one colour for all; label carries the meaning."
    },
    "governance": {
      "$type": "color",
      "$value": "{color.teal}",
      "$description": "Category accent. Default is one colour for all; label carries the meaning."
    },
    "community": {
      "$type": "color",
      "$value": "{color.teal}",
      "$description": "Category accent. Default is one colour for all; label carries the meaning."
    },
    "resources": {
      "$type": "color",
      "$value": "{color.teal}",
      "$description": "Category accent. Default is one colour for all; label carries the meaning."
    }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": "\"Source Sans 3\", \"Segoe UI\", Arial, sans-serif",
      "$description": "Interface, body, captions, labels, numbers."
    },
    "serif": {
      "$type": "fontFamily",
      "$value": "\"Source Serif 4\", Georgia, \"Times New Roman\", serif",
      "$description": "Wordmark, landing display headings, question text, recommendation headlines."
    },
    "mono": {
      "$type": "fontFamily",
      "$value": "ui-monospace, \"Cascadia Mono\", Consolas, monospace",
      "$description": "Calculation traces and technical detail only."
    }
  },
  "fontSize": {
    "display": {
      "$type": "dimension",
      "$value": "clamp(2.5rem, 1.75rem + 3vw, 4rem)",
      "$description": "Landing H1. Serif 600."
    },
    "heading": {
      "$type": "dimension",
      "$value": "clamp(2rem, 1.5rem + 1.5vw, 2.625rem)",
      "$description": "H2. Serif 600 on landing; sans 600 in the app."
    },
    "subheading": {
      "$type": "dimension",
      "$value": "clamp(1.375rem, 1.1rem + 1vw, 1.75rem)",
      "$description": "H3, question text (serif), card titles."
    },
    "body": {
      "$type": "dimension",
      "$value": "1.0625rem",
      "$description": "Body, 17px."
    },
    "small": {
      "$type": "dimension",
      "$value": "0.875rem",
      "$description": "Labels, metadata, captions."
    }
  },
  "type": {
    "weight-regular": {
      "$value": "400"
    },
    "weight-semibold": {
      "$value": "600"
    },
    "leading-body": {
      "$value": "1.7"
    },
    "leading-heading": {
      "$value": "1.15"
    },
    "tracking-heading-serif": {
      "$value": "-0.01em"
    },
    "wordmark-tracking": {
      "$value": "0.14em"
    }
  },
  "space": {
    "1": {
      "$type": "dimension",
      "$value": "0.25rem"
    },
    "2": {
      "$type": "dimension",
      "$value": "0.5rem"
    },
    "3": {
      "$type": "dimension",
      "$value": "0.75rem"
    },
    "4": {
      "$type": "dimension",
      "$value": "1rem"
    },
    "6": {
      "$type": "dimension",
      "$value": "1.5rem"
    },
    "8": {
      "$type": "dimension",
      "$value": "2rem"
    },
    "12": {
      "$type": "dimension",
      "$value": "3rem"
    },
    "16": {
      "$type": "dimension",
      "$value": "4rem"
    },
    "24": {
      "$type": "dimension",
      "$value": "6rem"
    }
  },
  "layout": {
    "section-space": {
      "$type": "dimension",
      "$value": "clamp(3rem, 6vw, 6rem)"
    },
    "page-gutter": {
      "$type": "dimension",
      "$value": "clamp(1.25rem, 4vw, 3rem)"
    },
    "content-width": {
      "$type": "dimension",
      "$value": "74rem"
    },
    "text-width": {
      "$type": "dimension",
      "$value": "40rem"
    },
    "control-height": {
      "$type": "dimension",
      "$value": "3rem"
    }
  },
  "radius": {
    "control": {
      "$type": "dimension",
      "$value": "0.625rem"
    },
    "panel": {
      "$type": "dimension",
      "$value": "0.875rem"
    },
    "tile": {
      "$type": "dimension",
      "$value": "0.375rem"
    },
    "chip": {
      "$type": "dimension",
      "$value": "0.35rem"
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "$value": "220ms"
    },
    "easing": {
      "$type": "cubicBezier",
      "$value": [
        0.2,
        0.7,
        0.3,
        1
      ]
    },
    "distance": {
      "$type": "dimension",
      "$value": "0.375rem"
    }
  }
}
