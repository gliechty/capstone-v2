# Recommendation runtime is intentionally disabled pending provider/model,
# live-call budget and SME data-transmission approval. No credentials needed.
# These are reserved server-side names for the reviewed live adapter; setting
# them does not activate external calls in the M3.1-M3.3 foundation.
# RECOMMENDATION_PROVIDER=
# RECOMMENDATION_MODEL=
# OPENAI_API_KEY=
# RECOMMENDATION_TIMEOUT_MS=10000
# RECOMMENDATION_MAX_OUTPUT_TOKENS=4000
# Current local limits are versioned in src/content/recommendations/policy.json.
