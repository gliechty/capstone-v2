# Server-only. Disabled unless provider, model and a funded project key are explicit.
RECOMMENDATION_PROVIDER=disabled
# Set openai to enable. No other provider or implicit personal-key fallback exists.
RECOMMENDATION_MODEL=gpt-5.4-mini
RECOMMENDATION_REASONING=low
RECOMMENDATION_TIMEOUT_MS=30000
RECOMMENDATION_MAX_OUTPUT_TOKENS=4000
OPENAI_API_KEY=
# Do not use NEXT_PUBLIC for any provider configuration or credentials.
# CAPSTONE_OFFLINE_TESTS=1 is set unconditionally by ordinary test runners.

# Private preview only: dedicated build target plus runtime opt-in; omit for normal production.
# CAPSTONE_BUILD_TARGET=private-preview
# CAPSTONE_PREVIEW_MODE=synthetic
# No OpenAI key is permitted in the deployed preview.
